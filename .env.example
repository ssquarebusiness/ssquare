# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web Push (generate with: npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ssquare.nadiad@gmail.com

# ---- Google Places API (New) for live reviews ----
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://ssquare-nadiad.vercel.app

# ---- Cron secret (protects /api/cron/* routes) ----
CRON_SECRET=

# ---- Seed script only (scripts/seed-users.ts) ----
SEED_SHAIL_PASSWORD=
SEED_SHUBH_PASSWORD=
SEED_RAVI_PASSWORD=
